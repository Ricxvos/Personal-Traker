# Modo demo: arranque local sin servicios externos.
# Usa: cp .env.demo .env.local && npm run demo

DEMO_MODE=true

# Postgres del docker-compose
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_tracker

# Supabase placeholders (no se llaman en demo, pero el cliente necesita strings válidos)
NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.local
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-service-key

# Anthropic deshabilitado en demo: el plan se genera solo con reglas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_AI_CALLS_PER_DAY=0

# Web Push (no se envían pushes en demo)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=demo-vapid-public
VAPID_PRIVATE_KEY=demo-vapid-private
VAPID_SUBJECT=mailto:demo@personal-tracker.local

# Integraciones externas vacías
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/integrations/ms-graph/callback
MS_TENANT_ID=common
OUTLOOK_ICS_URL=
COUPLER_MCP_URL=
COUPLER_MCP_TOKEN=

# Cron en demo no exige secret
CRON_SECRET=demo-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Mexico_City
