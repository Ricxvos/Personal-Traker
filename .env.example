# ==== Supabase ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_tracker

# ==== Anthropic (Claude Sonnet 4.6) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_AI_CALLS_PER_DAY=5

# ==== Web Push (VAPID) ====
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com

# ==== Google (Calendar + Fit) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ==== Microsoft Graph (Outlook empresarial) ====
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft
MS_TENANT_ID=common
# Fallback ICS feed si admin bloquea OAuth
OUTLOOK_ICS_URL=

# ==== Coupler.io MCP ====
COUPLER_MCP_URL=
COUPLER_MCP_TOKEN=

# ==== Cron secret (Vercel) ====
CRON_SECRET=

# ==== App ====
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Mexico_City
